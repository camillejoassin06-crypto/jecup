# Sans ces variables, JEC'UP fonctionne en mode local (données dans le navigateur,
# moteur pédagogique heuristique intégré). Renseigne-les pour activer Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "heuristic" (par défaut, hors ligne) ou "claude" (via la Edge Function supabase/functions/jecup-ai)
VITE_AI_PROVIDER=heuristic
